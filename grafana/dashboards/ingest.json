{
  "uid": "livestandings-ingest",
  "title": "Live Standings Ingest",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Ingest lag",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "standings_ingest_lag",
          "legendFormat": "lag",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Apply latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(standings_apply_latency_seconds_sum[1m]) / rate(standings_apply_latency_seconds_count[1m])",
          "legendFormat": "{{league}}",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Apply rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(standings_results_applied_total[1m])",
          "legendFormat": "{{league}}",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Stale/duplicate rejections",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(standings_stale_or_duplicate_rejections_total[1m])",
          "legendFormat": "rejections",
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }
        }
      ]
    }
  ]
}
